.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# large artifacts never committed; parquet metrics and figures ARE committed
results/**/*.safetensors
results/**/*.bin
results/**/*.pt
results/**/*.npz
hf_cache/
# raw KV-cache dumps (data, not metrics)
results/cache/
# local reference clones (NIAH + LongBench harnesses) — referenced, not vendored
/Long-Context-Data-Engineering/
/LongBench/
# superpowers SDD scratch — session scaffolding, not project artefacts
.superpowers/
# run debris classes (2026-07-25 results-tree curation): in-flight partials,
# VM stdout logs, and local scratch never carry doc-cited numbers
results/**/partial/
results/logs/
results/overnight_logs/
scratchpad/
/*.pdf
# attic: uncited superseded/iteration run dirs swept out of the active tree
# (bytes preserved on disk; doc-cited runs are always committed, never attic'd)
results/attic/
